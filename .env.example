SECRET_KEY=replace-with-a-secure-random-secret
# DATABASE_URL is optional; the default is instance/eventid.db.
# DATABASE_URL=sqlite:///eventid.db
# Enable secure cookies when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Use shared persistent storage such as redis://localhost:6379 in production.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute
# Maximum request size in bytes; the default is 5 MiB.
# MAX_CONTENT_LENGTH=5242880
